---
const { title, open = false } = Astro.props
---

<details {open}>
  <summary
    class="flex items-center text-muted-foreground hover:text-foreground transition-colors list-none py-2 cursor-pointer"
  >
    <span class="font-mono mr-2">{title}</span>
    <hr class="flex-1 h-px border-border border-dashed" />
  </summary>
  <slot />
</details>
