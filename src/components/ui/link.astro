---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { pathname } = new URL(Astro.request.url)
const { href, ...props } = Astro.props as Props
---

{
  href === pathname ? (
    <span {...props}>
      <slot />
    </span>
  ) : (
    <a href={href} {...props}>
      <slot />
    </a>
  )
}
