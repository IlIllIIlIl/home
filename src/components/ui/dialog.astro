---
const { id, className = '' } = Astro.props
---

<dialog
  id={id}
  closedby="any"
  class:list={[
    className,
    'fixed inset-0 m-auto max-w-lg border border-border text-foreground bg-background/95 shadow-lg backdrop-blur-sm',
    'opacity-0 scale-95 transition-all ease-out transition-discrete',
    '[&[open]]:(opacity-100 scale-100 starting:(opacity-0 scale-95))',
    '[&::backdrop]:(bg-background/75 backdrop-blur-sm opacity-0 transition-opacity ease-out transition-discrete)',
    '[&::backdrop]:(bg-[linear-gradient(45deg,var(--card)_12.5%,transparent_12.5%,transparent_50%,var(--card)_50%,var(--card)_62.5%,transparent_62.5%,transparent_100%)] bg-[length:0.25rem_0.25rem])',
    '[&[open]::backdrop]:(opacity-100 starting:opacity-0)',
  ]}
>
  <div class="p-4">
    <slot />
  </div>
  <div
    class="flex flex-row justify-end gap-2 px-4 py-3 bg-card/95 border-t border-border text-sm text-muted-foreground"
  >
    <slot name="actions" />
  </div>
</dialog>
