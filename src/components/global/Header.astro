---
import { config } from '@/config'
import Link from '@/components/global//Link.astro'
---

<header class="sticky top-0 z-50 flex items-center justify-between py-3 px-6 backdrop-blur-md" bg="background op-70">
  <Link href="/" text="foreground">{config.title}/index</Link>
  <nav flex gap-2 text-muted>
    {
      config.navLinks.map((href) => (
        <Link href={href} text="muted-foreground hover:foreground">
          {href}
        </Link>
      ))
    }
  </nav>
</header>
