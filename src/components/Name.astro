---
import { config } from '@/config'
---

<section id="name" class="typography">
  <button id="name-trigger" popovertarget="name-popover" class="group cursor-help">
    <h1>Ze Lee</h1>
  </button>
  <div
    id="name-popover"
    popover="hint"
    class="w-72 p-4 rounded-lg space-y-2 text-sm shadow-lg border border-border bg-card text-card-foreground"
  >
    {
      [
        { title: 'Characters', data: config.characters },
        { title: 'Transcriptions', data: config.transcriptions },
      ].map((section) => (
        <>
          <div class="text-xs font-medium text-muted-foreground">{section.title}</div>
          {section.data.map(([type, form]) => (
            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">{type}</span>
              <span class="font-medium">{form}</span>
            </div>
          ))}
        </>
      ))
    }
  </div>
</section>

<style>
  #name-trigger {
    anchor-name: --name-anchor;
  }
  #name-popover {
    position-anchor: --name-anchor;
    position-area: bottom span-right;
  }
</style>
