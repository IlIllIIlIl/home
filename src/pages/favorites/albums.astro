---
import PageHero from '@/components/PageHero.astro'
import Details from '@/components/global/Details.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const albums = await getCollection('albums')

function resolveName(n: string | Record<string, string> | undefined): string {
  if (typeof n === 'string') return n
  if (!n) return ''
  return n.en ?? Object.values(n)[0] ?? ''
}

const groups = albums.map((collection) => ({
  key: collection.id,
  items: Object.entries(collection.data).flatMap(([_, artist]) =>
    artist.releases.map((r) => ({ ...r, artist: artist.name })),
  ).sort((a, b) => {
    const ra = a.rating ?? 0
    const rb = b.rating ?? 0
    if (ra !== rb) return rb - ra
    return resolveName(a.artist).localeCompare(resolveName(b.artist), 'zh-Hant')
  }),
})).sort((a, b) => a.key.localeCompare(b.key, 'zh-Hant'))
---

<BaseLayout>
  <PageHero title="Albums" character="輯" />
  <div>
    {groups.map((group) => (
      <Details title={group.key}>
        {(() => {
          const albums = group.items.filter((i) => i.tracks)
          const singles = group.items.filter((i) => !i.tracks)
          return (
            <>
              {albums.length > 0 && (
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 items-center font-sans py-2">
                  {albums.map((item) => (
                    <div class="flex flex-col">
                      {item.cover && (
                        <img src={item.cover} alt={resolveName(item.title)} class="size-full border border-border" />
                      )}
                      <h3 class="mt-2 text-sm truncate">{resolveName(item.title)}</h3>
                      <p class="text-xs text-muted-foreground truncate">{resolveName(item.artist)}</p>
                    </div>
                  ))}
                </div>
              )}
              {singles.length > 0 && (
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 items-center font-sans py-2">
                  {singles.map((item) => (
                    <div class="flex items-center gap-2">
                      {item.cover && (
                        <img src={item.cover} alt={resolveName(item.title)} class="size-10 border border-border shrink-0" />
                      )}
                      <div class="min-w-0">
                        <h3 class="text-sm truncate">{resolveName(item.title)}</h3>
                        <p class="text-xs text-muted-foreground truncate">{resolveName(item.artist)}</p>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </>
          )
        })()}
      </Details>
    ))}
  </div>
</BaseLayout>
