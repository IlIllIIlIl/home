---
import PageHeader from '@/components/layout/page-header.astro'
import BaseLayout from '@/layouts/base-layout.astro'
import { formatDate } from '@/utils/format'
import { getCollection } from 'astro:content'

const title = "Writings"
const description = "Don't forget why you started just because you've gone too far."

const writings = await getCollection('writings', ({ data }) => {
  return data.private !== true
}).then((writings) => {
  return writings.sort((a, b) => {
    if (!a.data.date) return 1
    if (!b.data.date) return -1
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
  })
})

const drafts = writings.filter((w) => w.data.draft)
---

<BaseLayout>
  <PageHeader {title} {description} />
  <div class="divide">
    {
      writings
        .filter((w) => !w.data.draft)
        .map((writing) => (
          <a
            href={`/writings/${writing.id}`}
            class="flex items-center py-6 sm:py-3 hover:opacity-80 transition-opacity"
          >
            <div class="flex-1 items-center">
              <span class="font-sans">{writing.data.title}</span>
              <span class="text-muted font-mono hidden text-sm transition-opacity">{writing.id}</span>
            </div>
            <span
              class:list={[
                'text-muted font-sans text-sm',
                writing.data.updated && 'underline decoration-dashed decoration-offset-6 decoration-opacity-20',
              ]}
              title={writing.data.updated && `易於${formatDate(writing.data.updated as Date)}`}
            >
              {writing.data.date && formatDate(writing.data.date as Date)}
            </span>
          </a>
        ))
    }
  </div>
  <p class="mt-3 text-muted-foreground text-xs">
    All original texts are under
    <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.en" target="_blank" class="ml-1 link">CC BY-NC-SA 4.0</a>
  </p>
</BaseLayout>
